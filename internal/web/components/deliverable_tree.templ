package components

import (
	"github.com/aosanya/CodeValdCortex/internal/agency/models"
)

// DeliverableTreeBuilder renders the main tree builder interface
templ DeliverableTreeBuilder(agencyID string, workItemKey string, deliverables []models.DeliverableNode) {
	<div class="deliverable-tree-builder box" x-data="deliverableTree()">
		<!-- Toolbar -->
		<div class="level mb-4">
			<div class="level-left">
				<div class="level-item">
					<h3 class="title is-5">
						<span class="icon-text">
							<span class="icon">
								<i class="fas fa-folder-tree"></i>
							</span>
							<span>Deliverables Structure</span>
						</span>
					</h3>
				</div>
			</div>
			<div class="level-right">
				<div class="level-item">
					<div class="buttons">
						<button 
							type="button"
							class="button is-small is-info"
							@click="addRootFolder()"
							title="Add root folder">
							<span class="icon is-small">
								<i class="fas fa-folder-plus"></i>
							</span>
							<span>Add Folder</span>
						</button>
						<button 
							type="button"
							class="button is-small is-primary"
							@click="addRootFile()"
							title="Add root file">
							<span class="icon is-small">
								<i class="fas fa-file-circle-plus"></i>
							</span>
							<span>Add File</span>
						</button>
						<button 
							type="button"
							class="button is-small is-light"
							@click="expandAll()"
							title="Expand all folders">
							<span class="icon is-small">
								<i class="fas fa-angles-down"></i>
							</span>
						</button>
						<button 
							type="button"
							class="button is-small is-light"
							@click="collapseAll()"
							title="Collapse all folders">
							<span class="icon is-small">
								<i class="fas fa-angles-up"></i>
							</span>
						</button>
					</div>
				</div>
			</div>
		</div>

		<!-- Tree Container -->
		<div class="deliverable-tree-container" 
			 id="deliverable-tree-root"
			 x-init="initTree({ deliverables })">
			
			<!-- Empty state -->
			<template x-if="nodes.length === 0">
				<div class="notification is-light has-text-centered">
					<p class="mb-3">
						<span class="icon is-large has-text-grey-light">
							<i class="fas fa-folder-tree fa-3x"></i>
						</span>
					</p>
					<p class="has-text-grey">
						No deliverables defined yet. Add folders and files to define the structure of artifacts this work item will produce.
					</p>
					<p class="mt-4">
						<button 
							type="button"
							class="button is-info"
							@click="addRootFolder()">
							<span class="icon">
								<i class="fas fa-folder-plus"></i>
							</span>
							<span>Create First Folder</span>
						</button>
						<button 
							type="button"
							class="button is-primary"
							@click="addRootFile()">
							<span class="icon">
								<i class="fas fa-file-circle-plus"></i>
							</span>
							<span>Create First File</span>
						</button>
					</p>
				</div>
			</template>

			<!-- Tree nodes will be rendered by JavaScript -->
			<div id="tree-nodes-container" x-html="renderTree()"></div>
		</div>

		<!-- Hidden input to store tree data -->
		<input 
			type="hidden" 
			name="deliverables_structured"
			:value="JSON.stringify(nodes)"
			id="deliverables-data"/>

		<!-- Validation summary -->
		<div class="mt-4" x-show="validationErrors.length > 0">
			<div class="notification is-warning is-light">
				<p class="has-text-weight-semibold mb-2">
					<span class="icon">
						<i class="fas fa-triangle-exclamation"></i>
					</span>
					Validation Issues:
				</p>
				<ul>
					<template x-for="error in validationErrors" :key="error">
						<li x-text="error" class="ml-4"></li>
					</template>
				</ul>
			</div>
		</div>

		<!-- Stats -->
		<div class="level mt-4 is-size-7 has-text-grey">
			<div class="level-left">
				<div class="level-item">
					<span x-text="`${countNodes(nodes)} total items`"></span>
				</div>
				<div class="level-item">
					<span x-text="`${countFiles(nodes)} files`"></span>
				</div>
				<div class="level-item">
					<span x-text="`${countFolders(nodes)} folders`"></span>
				</div>
				<div class="level-item">
					<span x-text="`Max depth: ${getMaxDepth(nodes)}`"></span>
				</div>
			</div>
		</div>
	</div>
}

// PromptEditorModal renders a modal for editing prompt instructions
templ PromptEditorModal() {
	<div 
		class="modal"
		:class="{ 'is-active': promptEditorOpen }"
		x-data="{ promptEditorOpen: false, currentNode: null }"
		@edit-prompt.window="promptEditorOpen = true; currentNode = findNodeById($event.detail.nodeId)">
		
		<div class="modal-background" @click="promptEditorOpen = false"></div>
		<div class="modal-card">
			<header class="modal-card-head">
				<p class="modal-card-title">
					<span class="icon-text">
						<span class="icon">
							<i class="fas fa-message-lines"></i>
						</span>
						<span>Edit Prompt Instructions</span>
					</span>
				</p>
				<button class="delete" type="button" @click="promptEditorOpen = false"></button>
			</header>
			<section class="modal-card-body">
				<template x-if="currentNode">
					<div>
						<div class="field">
							<label class="label">
								<span>File/Folder:</span>
								<span class="has-text-weight-normal ml-2" x-text="currentNode.path"></span>
							</label>
						</div>

						<div class="field">
							<label class="label">Description (optional)</label>
							<div class="control">
								<input 
									type="text"
									class="input"
									x-model="currentNode.description"
									placeholder="Brief description of this deliverable"/>
							</div>
						</div>

						<div class="field">
							<label class="label">
								Prompt Instructions
								<span class="has-text-weight-normal has-text-grey ml-2">
									(<span x-text="currentNode.prompt_instructions ? currentNode.prompt_instructions.length : 0"></span>/5000 characters)
								</span>
							</label>
							<div class="control">
								<textarea 
									class="textarea"
									x-model="currentNode.prompt_instructions"
									rows="10"
									maxlength="5000"
									placeholder="Describe what should be achieved in this file/folder...

Example:
- What content should be included
- What format/structure to follow  
- What standards/guidelines apply
- Any specific requirements"></textarea>
							</div>
							<p class="help">
								These instructions will guide AI agents when creating this deliverable. Be specific about expectations.
							</p>
						</div>

						<!-- Inheritance preview -->
						<div class="notification is-info is-light mt-4" x-show="hasParentInstructions(currentNode.id)">
							<p class="has-text-weight-semibold mb-2">
								<span class="icon">
									<i class="fas fa-layer-group"></i>
								</span>
								Inherited Instructions:
							</p>
							<p class="is-size-7">
								This deliverable will also inherit prompt instructions from parent folders, providing additional context.
							</p>
						</div>
					</div>
				</template>
			</section>
			<footer class="modal-card-foot">
				<button class="button is-success" type="button" @click="promptEditorOpen = false">
					<span class="icon">
						<i class="fas fa-check"></i>
					</span>
					<span>Save</span>
				</button>
				<button class="button" type="button" @click="promptEditorOpen = false">Cancel</button>
			</footer>
		</div>
	</div>
}
