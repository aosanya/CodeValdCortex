package components

import (
	"github.com/aosanya/CodeValdCortex/internal/agency/models"
)

templ LayoutWithAgency(title string, currentAgency *models.Agency) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="agency-id" content={ currentAgency.ID }/>
		<title>{ title } - CodeValdCortex</title>
		
		@HeadIncludes()
	</head>
	<body>
		@NavbarWithAgency(currentAgency)		<main class="section">
			<div class="container">
				{ children... }
			</div>
		</main>
		
		@NavbarBurgerScript()
	</body>
</html>
}
