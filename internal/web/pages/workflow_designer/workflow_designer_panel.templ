package workflow_designer

import (
	"github.com/aosanya/CodeValdCortex/internal/agency/models"
)

// WorkflowChatPanel renders the chat/properties panel for workflow designer
templ WorkflowChatPanel(currentAgency *models.Agency, wf *models.Workflow) {
	<aside class="chat-panel" x-data="{ activeTab: 'properties' }">
		<header class="chat-header">
			<div class="chat-header-content">
				<span class="icon is-medium has-text-primary">
					<i class="fas fa-project-diagram"></i>
				</span>
				<div>
					<h3 class="chat-title">Workflow</h3>
					<p class="chat-subtitle">{ wf.Name }</p>
				</div>
			</div>
		</header>
		
		<!-- Tabs -->
		<div class="tabs is-fullwidth is-small">
			<ul>
				<li :class="activeTab === 'properties' ? 'is-active' : ''">
					<a @click.prevent="activeTab = 'properties'">
						<span class="icon is-small">
							<i class="fas fa-sliders"></i>
						</span>
						<span>Properties</span>
					</a>
				</li>
				<li :class="activeTab === 'info' ? 'is-active' : ''">
					<a @click.prevent="activeTab = 'info'">
						<span class="icon is-small">
							<i class="fas fa-info-circle"></i>
						</span>
						<span>Info</span>
					</a>
				</li>
				<li :class="activeTab === 'legend' ? 'is-active' : ''">
					<a @click.prevent="activeTab = 'legend'">
						<span class="icon is-small">
							<i class="fas fa-map-signs"></i>
						</span>
						<span>Legend</span>
					</a>
				</li>
			</ul>
		</div>
		
		<!-- Properties Tab Content -->
		<div x-show="activeTab === 'properties'" style="overflow-y: auto; flex: 1; padding: 1rem;">
			<div id="properties-panel-content">
				<div class="notification is-light has-text-centered">
					<p class="has-text-grey">
						<span class="icon is-large">
							<i class="fas fa-mouse-pointer fa-2x"></i>
						</span>
					</p>
					<p class="has-text-grey mt-3">
						Click a step or work item to view properties
					</p>
				</div>
			</div>
		</div>
		
		<!-- Info Tab Content -->
		<div x-show="activeTab === 'info'" style="overflow-y: auto; flex: 1; padding: 1rem;">
			<div class="content">
				<h4 class="title is-6">Workflow Information</h4>
				<div class="field">
					<label class="label is-small">Name</label>
					<p class="is-size-7">{ wf.Name }</p>
				</div>
				<div class="field">
					<label class="label is-small">Description</label>
					<p class="is-size-7">{ wf.Description }</p>
				</div>
				<div class="field">
					<label class="label is-small">Version</label>
					<p class="is-size-7">{ wf.Version }</p>
				</div>
				<div class="field">
					<label class="label is-small">Steps</label>
					<p class="is-size-7" x-text="`${workflowSteps.length} step(s)`">0 steps</p>
				</div>
				<div class="field">
					<label class="label is-small">Work Items</label>
					<p class="is-size-7" x-text="`${workflowSteps.reduce((sum, s) => sum + s.items.length, 0)} work item(s)`">0 work items</p>
				</div>
			</div>
		</div>
		
		<!-- Legend Tab Content -->
		<div x-show="activeTab === 'legend'" style="overflow-y: auto; flex: 1; padding: 1rem;">
			<div class="content">
				<h4 class="title is-6">
					<span class="icon-text">
						<span class="icon has-text-info">
							<i class="fas fa-info-circle"></i>
						</span>
						<span>Route Legend</span>
					</span>
				</h4>
				
				<p class="is-size-7 mb-4 has-text-grey">
					Workflow steps can be connected with different route types to represent conditional logic.
				</p>
				
				<div class="box has-background-light p-3 mb-3">
					<div class="level is-mobile mb-2">
						<div class="level-left">
							<span class="icon-text">
								<span class="icon has-text-success">
									<i class="fas fa-arrow-down fa-lg"></i>
								</span>
								<span class="is-size-7"><strong>Success</strong></span>
							</span>
						</div>
					</div>
					<p class="is-size-7 has-text-grey pl-4">
						Normal flow when step completes successfully
					</p>
					<div style="width: 4px; height: 40px; margin: 8px auto; background: linear-gradient(to bottom, transparent, #48c774, transparent); border-radius: 2px;"></div>
				</div>
				
				<div class="box has-background-light p-3 mb-3">
					<div class="level is-mobile mb-2">
						<div class="level-left">
							<span class="icon-text">
								<span class="icon has-text-danger">
									<i class="fas fa-arrow-down fa-lg"></i>
								</span>
								<span class="is-size-7"><strong>Failure/Error</strong></span>
							</span>
						</div>
					</div>
					<p class="is-size-7 has-text-grey pl-4">
						Alternative path when step encounters an error
					</p>
					<div style="width: 4px; height: 40px; margin: 8px auto; background: linear-gradient(to bottom, transparent, #f14668, transparent); border-radius: 2px;"></div>
				</div>
				
				<div class="box has-background-light p-3 mb-3">
					<div class="level is-mobile mb-2">
						<div class="level-left">
							<span class="icon-text">
								<span class="icon has-text-warning">
									<i class="fas fa-arrow-down fa-lg"></i>
								</span>
								<span class="is-size-7"><strong>Retry/Skip</strong></span>
							</span>
						</div>
					</div>
					<p class="is-size-7 has-text-grey pl-4">
						Loop back or skip steps based on conditions
					</p>
					<div style="width: 4px; height: 40px; margin: 8px auto; background: linear-gradient(to bottom, transparent, #ffdd57, transparent); border-radius: 2px;"></div>
				</div>
				
				<div class="box has-background-light p-3 mb-3">
					<div class="level is-mobile mb-2">
						<div class="level-left">
							<span class="icon-text">
								<span class="icon has-text-info">
									<i class="fas fa-arrow-down fa-lg"></i>
								</span>
								<span class="is-size-7"><strong>Human Decision</strong></span>
							</span>
						</div>
					</div>
					<p class="is-size-7 has-text-grey pl-4">
						Routing determined by human approval or choice
					</p>
					<div style="width: 4px; height: 40px; margin: 8px auto; background: linear-gradient(to bottom, transparent, #3298dc, transparent); border-radius: 2px;"></div>
				</div>
				
				<article class="message is-info is-small mt-4">
					<div class="message-body">
						<p class="is-size-7">
							<span class="icon">
								<i class="fas fa-lightbulb"></i>
							</span>
							Route colors are available for workflow arrows. Future updates will add conditional routing logic and branch visualization.
						</p>
					</div>
				</article>
			</div>
		</div>
	</aside>
}
