package pages

import (
	"strconv"
	"github.com/aosanya/CodeValdCortex/internal/agency/models"
	"github.com/aosanya/CodeValdCortex/internal/web/components"
)

templ Workbench(agency *models.Agency, board *models.WorkbenchBoard) {
	@components.LayoutWithAgency("Workbench", agency) {
		<section class="section">
			<!-- Page Header -->
			<div class="mb-5">
				<div class="level">
					<div class="level-left">
						<div class="level-item">
							<div>
								<h1 class="title mb-2">Workbench</h1>
								<div class="tags has-addons">
									<span class="tag is-medium is-light">Instance</span>
									<span class="tag is-medium is-info">{ board.InstanceName }</span>
								</div>
							</div>
						</div>
						<div class="level-item">
							<div>
								<p class="heading">Workflow</p>
								<p class="subtitle is-5 mb-0">{ board.WorkflowName }</p>
							</div>
						</div>
					</div>
					<div class="level-right">
						<div class="level-item">
							<button class="button is-primary" onclick="toggleCreateIssuePanel()">
								<span class="icon"><i class="fas fa-plus"></i></span>
								<span>Create Issue</span>
							</button>
						</div>
					</div>
				</div>
			</div>

			<!-- Create Issue Form Component -->
			@components.IssueManageForm(agency, board)

			<!-- Kanban Board -->
			<div class="workbench-board" style="overflow-x: auto;">
				<div class="columns is-variable is-2" style="min-width: max-content;">
					for _, column := range board.Columns {
						<div class="column workbench-column" style="min-width: 320px; max-width: 320px;">
							<!-- Column Header -->
							<div class="box has-background-light mb-3">
								<div class="level mb-0">
									<div class="level-left">
										<div style="max-width: 240px;">
											<p class="heading mb-1">{ column.WorkItemCode }</p>
											<p class="title is-6 mb-0" style="white-space: normal; line-height: 1.3; overflow-wrap: anywhere; word-break: break-word;">{ column.Name }</p>
										</div>
									</div>
									<div class="level-right">
										<span class="tag is-rounded">{ strconv.Itoa(len(column.Issues)) }</span>
									</div>
								</div>
							</div>

							<!-- Issues in Column -->
							<div class="workbench-issues" style="min-height: 200px;">
								if len(column.Issues) == 0 {
									<div class="box has-background-white-ter has-text-centered" style="padding: 2rem;">
										<p class="has-text-grey-light">
											<span class="icon is-large">
												<i class="fas fa-inbox fa-2x"></i>
											</span>
										</p>
										<p class="has-text-grey">No issues</p>
									</div>
								} else {
									for _, issue := range column.Issues {
										@components.IssueCard(&issue, agency.Key, board.InstanceID)
									}
								}
							</div>
						</div>
					}
				</div>
			</div>
		</section>

		<!-- Workbench JavaScript -->
		<script>
			function refreshWorkbench() {
				window.location.reload();
			}

			function openIssueDetails(agencyID, instanceID, issueKey) {
				// Load issue data and populate the create form for editing
				const panel = document.getElementById('createIssuePanel');
				if (!panel) return;

				
				// Fetch issue data from API
				fetch(`/api/v1/agencies/${agencyID}/instances/${instanceID}/issues/${issueKey}`)
					.then(response => {
						if (!response.ok) {
							throw new Error(`Failed to load issue: ${response.status}`);
						}
						return response.json();
					})
					.then(data => {
						
						// Populate form fields
						const form = document.getElementById('createIssueForm');
						if (form) {
							const titleInput = form.querySelector('input[name="title"]');
							const descInput = form.querySelector('textarea[name="description"]');
							
							if (titleInput) titleInput.value = data.title || '';
							if (descInput) descInput.value = data.description || '';
							
							// Store issue key in panel for update mode
							panel.dataset.editingIssueKey = issueKey;
							
							// Update panel header to show edit mode
							const header = panel.querySelector('.level-left .level-item strong');
							if (header) {
								header.textContent = `Edit Issue #${data.number}`;
							}
							
							// Update button text to "Update Issue"
							const submitBtn = panel.querySelector('button[onclick="submitCreateIssue()"]');
							if (submitBtn) {
								submitBtn.textContent = 'Update Issue';
							}
						}
						
						// Show the panel
						panel.style.display = 'block';
					})
					.catch(error => {
						alert('Failed to load issue details: ' + error.message);
					});
			}
		</script>

		<!-- Workbench Styles -->
		<style>
			.workbench-board {
				padding-bottom: 1rem;
			}

			.workbench-column {
				flex-shrink: 0;
			}

			.workbench-issues {
				display: flex;
				flex-direction: column;
				gap: 0.75rem;
			}

			.issue-card {
				transition: box-shadow 0.2s;
			}

			.issue-card .card-header:hover {
				background-color: hsl(0, 0%, 98%);
			}

			.issue-title {
				font-size: 1rem;
				line-height: 1.4;
				word-wrap: break-word;
				overflow-wrap: break-word;
			}

			.issue-description {
				line-height: 1.4;
				max-height: 4.2em; /* 3 lines */
				overflow: hidden;
				display: -webkit-box;
				-webkit-line-clamp: 3;
				-webkit-box-orient: vertical;
				word-wrap: break-word;
			}
		</style>
	}
}
