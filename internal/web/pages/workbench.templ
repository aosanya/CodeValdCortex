package pages

import (
	"fmt"
	"strconv"
	"github.com/aosanya/CodeValdCortex/internal/agency/models"
	"github.com/aosanya/CodeValdCortex/internal/web/components"
)

// Helper function to get status badge class
func getStatusBadgeClass(status string) string {
	switch status {
	case models.IssueStatusOpen:
		return "is-info"
	case models.IssueStatusAssigned:
		return "is-warning"
	case models.IssueStatusInProgress:
		return "is-primary"
	case models.IssueStatusReadyForReview:
		return "is-link"
	case models.IssueStatusCompleted:
		return "is-success"
	case models.IssueStatusBlocked:
		return "is-danger"
	default:
		return "is-light"
	}
}

// Helper function to format issue number
func formatIssueNumber(number int) string {
	return fmt.Sprintf("#%d", number)
}

templ Workbench(agency *models.Agency, board *models.WorkbenchBoard) {
	@components.LayoutWithAgency("Workbench", agency) {
		<section class="section">
			<!-- Page Header -->
			<div class="mb-5">
				<div class="level">
					<div class="level-left">
						<div class="level-item">
							<div>
								<h1 class="title mb-2">Workbench</h1>
								<div class="tags has-addons">
									<span class="tag is-medium is-light">Instance</span>
									<span class="tag is-medium is-info">{ board.InstanceName }</span>
								</div>
							</div>
						</div>
						<div class="level-item">
							<div>
								<p class="heading">Workflow</p>
								<p class="subtitle is-5 mb-0">{ board.WorkflowName }</p>
							</div>
						</div>
					</div>
					<div class="level-right">
						<div class="level-item">
							<button class="button is-primary" onclick="toggleCreateIssuePanel()">
								<span class="icon"><i class="fas fa-plus"></i></span>
								<span>Create Issue</span>
							</button>
						</div>
					</div>
				</div>
			</div>

			<!-- Kanban Board -->
			<div class="workbench-board" style="overflow-x: auto;">
				<div class="columns is-variable is-2" style="min-width: max-content;">
					for _, column := range board.Columns {
						<div class="column workbench-column" style="min-width: 320px; max-width: 320px;">
							<!-- Column Header -->
							<div class="box has-background-light mb-3">
								<div class="level mb-0">
									<div class="level-left">
										<div style="max-width: 240px;">
											<p class="heading mb-1">{ column.WorkItemCode }</p>
											<p class="title is-6 mb-0" style="white-space: normal; line-height: 1.3; overflow-wrap: anywhere; word-break: break-word;">{ column.Name }</p>
										</div>
									</div>
									<div class="level-right">
										<span class="tag is-rounded">{ strconv.Itoa(len(column.Issues)) }</span>
									</div>
								</div>
							</div>

							<!-- Issues in Column -->
							<div class="workbench-issues" style="min-height: 200px;">
								if len(column.Issues) == 0 {
									<div class="box has-background-white-ter has-text-centered" style="padding: 2rem;">
										<p class="has-text-grey-light">
											<span class="icon is-large">
												<i class="fas fa-inbox fa-2x"></i>
											</span>
										</p>
										<p class="has-text-grey">No issues</p>
									</div>
								} else {
									for _, issue := range column.Issues {
										@IssueCard(&issue, agency.Key, board.InstanceID)
									}
								}
							</div>
						</div>
					}
				</div>
			</div>
		</section>

			<!-- Create Issue Panel (inline, not a popup) -->
			<div id="createIssuePanel" class="box" style="display: none; margin-bottom: 1rem;">
				<div class="level">
					<div class="level-left">
						<div class="level-item">
							<strong>Create New Issue</strong>
						</div>
					</div>
					<div class="level-right">
						<div class="level-item">
							<button class="button" onclick="closeCreateIssuePanel()">Close</button>
						</div>
					</div>
				</div>

				<form id="createIssueForm">
					<div class="field">
						<label class="label">Title</label>
						<div class="control">
							<input class="input" type="text" name="title" placeholder="Issue title" required/>
						</div>
					</div>

					<div class="field">
						<label class="label">Description</label>
						<div class="control">
							<textarea class="textarea" name="description" placeholder="Issue description" rows="4"></textarea>
						</div>
					</div>

					<!-- Workflow is not shown to the user; we attach board.WorkflowID in the request -->
					<div class="field is-grouped">
						<div class="control">
							<button type="button" class="button is-primary" onclick="submitCreateIssue()">Create Issue</button>
						</div>
						<div class="control">
							<button type="button" class="button" onclick="closeCreateIssuePanel()">Cancel</button>
						</div>
					</div>
				</form>
			</div>

		<!-- Workbench JavaScript -->
		<script>
			function toggleCreateIssuePanel() {
				const panel = document.getElementById('createIssuePanel');
				if (!panel) return;
				if (panel.style.display === 'none' || panel.style.display === '') {
					panel.style.display = 'block';
				} else {
					panel.style.display = 'none';
					document.getElementById('createIssueForm').reset();
				}
			}

			function closeCreateIssuePanel() {
				const panel = document.getElementById('createIssuePanel');
				if (!panel) return;
				panel.style.display = 'none';
				document.getElementById('createIssueForm').reset();
			}

			function submitCreateIssue() {
				const form = document.getElementById('createIssueForm');
				const formData = new FormData(form);

				const data = {
					title: formData.get('title'),
					description: formData.get('description'),
					// workflow_id is attached from the server-side board context
					workflow_id: '{ board.WorkflowID }'
				};

				const agencyID = '{ agency.Key }';
				const instanceID = '{ board.InstanceID }';

				fetch(`/api/v1/agencies/${agencyID}/instances/${instanceID}/issues`, {
					method: 'POST',
					headers: {
						'Content-Type': 'application/json',
					},
					body: JSON.stringify(data)
				})
				.then(response => response.json())
				.then(data => {
					closeCreateIssuePanel();
					// Reload page to show new issue
					window.location.reload();
				})
				.catch(error => {
					console.error('Error creating issue:', error);
					alert('Failed to create issue');
				});
			}

			function refreshWorkbench() {
				window.location.reload();
			}
		</script>

		<!-- Workbench Styles -->
		<style>
			.workbench-board {
				padding-bottom: 1rem;
			}

			.workbench-column {
				flex-shrink: 0;
			}

			.workbench-issues {
				display: flex;
				flex-direction: column;
				gap: 0.75rem;
			}

			.issue-card {
				cursor: pointer;
				transition: transform 0.2s, box-shadow 0.2s;
			}

			.issue-card:hover {
				transform: translateY(-2px);
				box-shadow: 0 0.5em 1em -0.125em rgba(10, 10, 10, 0.15), 0 0px 0 1px rgba(10, 10, 10, 0.02);
			}
		</style>
	}
}

// IssueCard component renders a single issue card
templ IssueCard(issue *models.WorkIssue, agencyID string, instanceID string) {
	<div class="box issue-card" onclick={ templ.ComponentScript{Call: fmt.Sprintf("openIssueDetails('%s', '%s', '%s')", agencyID, instanceID, issue.Key)} }>
		<div class="level mb-2">
			<div class="level-left">
				<span class="tag is-light">{ formatIssueNumber(issue.Number) }</span>
			</div>
			<div class="level-right">
				<span class={ "tag", getStatusBadgeClass(issue.Status) }>{ issue.Status }</span>
			</div>
		</div>
		
		<p class="title is-6 mb-2">{ issue.Title }</p>
		
		if issue.Description != "" {
			<p class="subtitle is-7 has-text-grey mb-3" style="line-height: 1.3; max-height: 3.9em; overflow: hidden;">
				{ issue.Description }
			</p>
		}
		
		<div class="level mb-0">
			<div class="level-left">
				if issue.AssignedTo != "" {
					<div class="level-item">
						<span class="icon-text">
							<span class="icon has-text-grey-light">
								<i class="fas fa-user"></i>
							</span>
							<span class="is-size-7 has-text-grey">{ issue.AssignedTo }</span>
						</span>
					</div>
				}
			</div>
			<div class="level-right">
				<span class="is-size-7 has-text-grey-light">
					{ issue.CreatedAt.Format("Jan 02") }
				</span>
			</div>
		</div>
	</div>
}
