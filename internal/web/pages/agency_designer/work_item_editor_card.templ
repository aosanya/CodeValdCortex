package agency_designer

// WorkItemEditorCard renders the work item editor card component
templ WorkItemEditorCard() {
	<!-- Work Item Editor Card (Hidden by default) -->
	<div class="card mb-4 is-hidden" id="work-item-editor-card">
		<header class="card-header">
			<p class="card-header-title">
				<span class="icon"><i class="fas fa-edit"></i></span>
				<span id="work-item-editor-title">Add New Work Item</span>
			</p>
			<button
				class="card-header-icon button is-small is-text"
				onclick="cancelWorkItemEdit()"
				title="Cancel"
			>
				<span class="icon"><i class="fas fa-times"></i></span>
			</button>
		</header>
		<div class="card-content m-0 p-0">
			<!-- Single Panel with Tabs -->
			<nav class="panel">
				<p class="panel-tabs has-background">
					<a class="is-active" data-tab="basic" onclick="switchWorkItemTab(event, 'basic')">
						<span class="icon is-small"><i class="fas fa-info-circle"></i></span>
						<span>Basic Info</span>
					</a>
					<a data-tab="deliverables" onclick="switchWorkItemTab(event, 'deliverables')">
						<span class="icon is-small"><i class="fas fa-folder-tree"></i></span>
						<span>Deliverables</span>
					</a>
					<a data-tab="goals" onclick="switchWorkItemTab(event, 'goals')">
						<span class="icon is-small"><i class="fas fa-bullseye"></i></span>
						<span>Goals & Tags</span>
					</a>
				</p>
				<!-- Tab Content 1: Basic Information -->
				<div id="work-item-tab-basic" class="work-item-tab-content">
					<div class="panel-block is-block">
						<div class="content p-0 m-0">
							<!-- Code Field -->
							<div class="field">
								<label class="label">Work Item Code</label>
								<div class="control">
									<input
										class="input"
										type="text"
										id="work-item-code-editor"
										placeholder="e.g., WI001, UOW-1, etc."
										maxlength="50"
									/>
								</div>
								<p class="help">A unique code to identify this work item (e.g., WI001, UOW-1).</p>
							</div>
							<!-- Title Field -->
							<div class="field">
								<label class="label">Title</label>
								<div class="control">
									<input
										class="input"
										type="text"
										id="work-item-title-editor"
										placeholder="e.g., Implement user authentication"
										maxlength="200"
									/>
								</div>
								<p class="help">A concise title describing this work item.</p>
							</div>
							<!-- Description Field -->
							<div class="field">
								<label class="label">Description</label>
								<div class="control">
									<textarea
										class="textarea"
										id="work-item-description-editor"
										placeholder="Describe the work item in detail..."
										rows="6"
										style="font-family: monospace; font-size: 14px;"
									></textarea>
								</div>
								<p class="help">Provide a detailed description of the work to be done.</p>
							</div>
						</div>
					</div>
				</div>
				<!-- Tab Content 2: Deliverables -->
				<div id="work-item-tab-deliverables" class="work-item-tab-content" style="display: none;">
					<div class="panel-block is-block">
						<div class="content p-0 m-0">
							<!-- Deliverable Tree Builder Component -->
							<div id="deliverable-tree-container">
								<!-- Tree builder will be rendered here dynamically -->
							</div>
						</div>
					</div>
				</div>
				<!-- Tab Content 3: Goals & Tags -->
				<div id="work-item-tab-goals" class="work-item-tab-content" style="display: none;">
					<div class="panel-block is-block">
						<div class="content p-0 m-0">
							<!-- Goals Field -->
							<div class="field">
								<label class="label">Linked Goals</label>
								<div class="control">
									<div id="work-item-goals-editor" class="box" style="max-height: 300px; overflow-y: auto;">
										<!-- Goals will be populated dynamically as checkboxes -->
									</div>
								</div>
								<p class="help">Select one or more goals this work item addresses.</p>
							</div>
							<!-- Tags Field -->
							<div class="field">
								<label class="label">Tags</label>
								<div class="control">
									<input
										class="input"
										type="text"
										id="work-item-tags-editor"
										placeholder="e.g., backend, api, security"
									/>
								</div>
								<p class="help">Comma-separated tags for categorization.</p>
							</div>
						</div>
					</div>
				</div>
			</nav>
			<script>
// Tab switching function for work item editor
window.switchWorkItemTab = function(event, tabName) {
    event.preventDefault();
    
    // Hide all tab contents
    const tabContents = document.querySelectorAll('.work-item-tab-content');
    tabContents.forEach(content => {
        content.style.display = 'none';
    });
    
    // Remove active class from all tabs
    const tabs = document.querySelectorAll('.panel-tabs a');
    tabs.forEach(tab => {
        tab.classList.remove('is-active');
    });
    
    // Show selected tab content
    const selectedContent = document.getElementById('work-item-tab-' + tabName);
    if (selectedContent) {
        selectedContent.style.display = 'block';
    }
    
    // Add active class to clicked tab
    event.currentTarget.classList.add('is-active');
}
</script>
		</div>
		<footer class="card-footer">
			<div class="card-footer-item">
				<button
					class="button is-small is-primary"
					onclick="saveWorkItemFromEditor()"
				>
					<span class="icon"><i class="fas fa-save"></i></span>
					<span>Save</span>
				</button>
			</div>
			<div class="card-footer-item">
				<button
					class="button is-small"
					onclick="cancelWorkItemEdit()"
				>
					<span class="icon"><i class="fas fa-times"></i></span>
					<span>Cancel</span>
				</button>
			</div>
		</footer>
	</div>
}
