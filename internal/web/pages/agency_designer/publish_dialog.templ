package agency_designer

// PublishDialog renders the modal dialog for publishing an agency
// Includes version input, description, auto-activate and tag creation options
templ PublishDialog() {
	<div class="modal" id="publish-dialog">
		<div class="modal-background" onclick="closePublishDialog()"></div>
		<div class="modal-card">
			<header class="modal-card-head">
				<p class="modal-card-title">
					<span class="icon-text">
						<span class="icon">
							<i class="fas fa-upload"></i>
						</span>
						<span>Publish Agency</span>
					</span>
				</p>
				<button class="delete" aria-label="close" onclick="closePublishDialog()"></button>
			</header>
			
			<section class="modal-card-body">
				<!-- Validation Status (shown before allowing publish) -->
				<div class="notification is-info is-light" id="validation-status-info">
					<p class="has-text-weight-semibold">
						<span class="icon"><i class="fas fa-info-circle"></i></span>
						Checking validation status...
					</p>
				</div>
				
				<div class="notification is-danger" id="validation-errors" style="display: none;">
					<p class="has-text-weight-semibold mb-2">
						<span class="icon"><i class="fas fa-exclamation-triangle"></i></span>
						Validation Errors
					</p>
					<div id="validation-error-list"></div>
				</div>
				
				<!-- Publish Form (shown when validated) -->
				<div id="publish-form" style="display: none;">
					<!-- Version Input -->
					<div class="field">
						<label class="label">Version *</label>
						<div class="control has-icons-left">
							<input 
								class="input" 
								type="text" 
								id="publish-version"
								placeholder="v1.0.0"
								pattern="^v?\d+\.\d+\.\d+(-[a-zA-Z0-9.-]+)?$"
								required>
							<span class="icon is-small is-left">
								<i class="fas fa-code-branch"></i>
							</span>
						</div>
						<p class="help">Semantic version (e.g., v1.0.0, v2.1.3-beta)</p>
					</div>
					
					<!-- Description -->
					<div class="field">
						<label class="label">Description *</label>
						<div class="control">
							<textarea 
								class="textarea" 
								id="publish-description"
								placeholder="Describe the changes in this version..."
								rows="4"
								required></textarea>
						</div>
						<p class="help">What's new or changed in this publication?</p>
					</div>
					
					<!-- Auto-activate checkbox -->
					<div class="field">
						<div class="control">
							<label class="checkbox">
								<input type="checkbox" id="publish-auto-activate">
								<span class="icon-text ml-2">
									<span class="icon"><i class="fas fa-play"></i></span>
									<span>Auto-activate after publishing</span>
								</span>
							</label>
						</div>
						<p class="help">
							If checked, agency will automatically transition to Active state 
							(spawn agents and start workflows)
						</p>
					</div>
					
					<!-- Create tag checkbox -->
					<div class="field">
						<div class="control">
							<label class="checkbox">
								<input 
									type="checkbox" 
									id="publish-create-tag"
									onchange="toggleTagNameInput()">
								<span class="icon-text ml-2">
									<span class="icon"><i class="fas fa-tag"></i></span>
									<span>Create tag before publishing</span>
								</span>
							</label>
						</div>
						<p class="help">
							Create an immutable snapshot tag of the current state before publishing
						</p>
					</div>
					
					<!-- Tag name input (conditional) -->
					<div class="field ml-5" id="tag-name-field" style="display: none;">
						<label class="label">Tag Name</label>
						<div class="control has-icons-left">
							<input 
								class="input" 
								type="text" 
								id="publish-tag-name"
								placeholder="pre-publish-snapshot">
							<span class="icon is-small is-left">
								<i class="fas fa-tag"></i>
							</span>
						</div>
						<p class="help">Leave empty to auto-generate from version</p>
					</div>
					
					<!-- Publication Preview -->
					<div class="box mt-4" style="background-color: #f5f5f5;">
						<p class="has-text-weight-semibold mb-2">Publication Summary</p>
						<div class="content is-small">
							<p><strong>Version:</strong> <span id="preview-version">-</span></p>
							<p><strong>Description:</strong> <span id="preview-description">-</span></p>
							<p><strong>Actions:</strong></p>
							<ul id="preview-actions">
								<li>Create publication snapshot</li>
								<li>Generate deployment manifest</li>
								<li id="preview-tag-action" style="display: none;">Create tag: <span id="preview-tag-name"></span></li>
								<li id="preview-activate-action" style="display: none;">Auto-activate agency</li>
							</ul>
						</div>
					</div>
				</div>
			</section>
			
			<footer class="modal-card-foot">
				<div class="buttons">
					<button 
						class="button is-primary"
						id="confirm-publish-btn"
						onclick="handlePublishSubmit()"
						disabled>
						<span class="icon"><i class="fas fa-upload"></i></span>
						<span>Publish</span>
					</button>
					<button class="button" onclick="closePublishDialog()">Cancel</button>
				</div>
				<div id="publish-progress" class="is-flex-grow-1" style="display: none;">
					<progress class="progress is-primary" max="100"></progress>
					<p class="help">Publishing agency...</p>
				</div>
			</footer>
		</div>
	</div>
}
