package agency_designer

import (
	"github.com/aosanya/CodeValdCortex/internal/policy"
)

// AIPolicyWizard renders the AI Policy Configuration Wizard
templ AIPolicyWizard(agencyID string, existingPolicy *policy.AIPolicy) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>AI Policy Configuration - Agency { agencyID }</title>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@1.0.0/css/bulma.min.css"/>
			<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>
			<link rel="stylesheet" href="/static/css/ai-policy-wizard.css"/>
			<!-- Alpine.js -->
			<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
			<!-- AI Policy Wizard Script -->
			<script src="/static/js/ai-policy-wizard.js"></script>
		</head>
		<body>
			<div
				class="policy-wizard-container"
				x-data="policyWizard()"
				data-agency-id={ agencyID }
				if existingPolicy != nil {
					data-existing-policy={ templ.JSONString(existingPolicy) }
				}
			>
				<!-- Header -->
				<nav class="navbar is-light" role="navigation">
					<div class="navbar-brand">
						<div class="navbar-item">
							<a href={ templ.SafeURL("/agencies/" + agencyID + "/designer") } class="button is-small is-ghost">
								<span class="icon"><i class="fas fa-arrow-left"></i></span>
								<span>Back to Agency Designer</span>
							</a>
						</div>
					</div>
					<div class="navbar-menu">
						<div class="navbar-start">
							<div class="navbar-item">
								<h1 class="title is-4 mb-0">
									<span class="icon-text">
										<span class="icon has-text-primary"><i class="fas fa-shield-halved"></i></span>
										<span>AI Policy Configuration</span>
									</span>
								</h1>
							</div>
						</div>
						<div class="navbar-end">
							<div class="navbar-item">
								<button @click="savePolicy()" class="button is-primary" :disabled="saving || !isValid()">
									<span class="icon"><i class="fas fa-save"></i></span>
									<span x-text="saving ? 'Saving...' : 'Save Policy'">Save Policy</span>
								</button>
							</div>
						</div>
					</div>
				</nav>

				<!-- Progress Indicator -->
				<div class="section py-4">
					<div class="container">
						<div class="steps" id="wizard-steps">
							<div class="step-item" :class="{'is-active': currentStep === 1, 'is-completed': currentStep > 1}" @click="goToStep(1)">
								<div class="step-marker">1</div>
								<div class="step-details">
									<p class="step-title">Stance</p>
								</div>
							</div>
							<div class="step-item" :class="{'is-active': currentStep === 2, 'is-completed': currentStep > 2}" @click="goToStep(2)">
								<div class="step-marker">2</div>
								<div class="step-details">
									<p class="step-title">Models</p>
								</div>
							</div>
							<div class="step-item" :class="{'is-active': currentStep === 3, 'is-completed': currentStep > 3}" @click="goToStep(3)">
								<div class="step-marker">3</div>
								<div class="step-details">
									<p class="step-title">Autonomy</p>
								</div>
							</div>
							<div class="step-item" :class="{'is-active': currentStep === 4, 'is-completed': currentStep > 4}" @click="goToStep(4)">
								<div class="step-marker">4</div>
								<div class="step-details">
									<p class="step-title">Data Access</p>
								</div>
							</div>
							<div class="step-item" :class="{'is-active': currentStep === 5, 'is-completed': currentStep > 5}" @click="goToStep(5)">
								<div class="step-marker">5</div>
								<div class="step-details">
									<p class="step-title">Actions & Risk</p>
								</div>
							</div>
							<div class="step-item" :class="{'is-active': currentStep === 6}" @click="goToStep(6)">
								<div class="step-marker">6</div>
								<div class="step-details">
									<p class="step-title">Compliance</p>
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- Step Content -->
				<div class="section">
					<div class="container">
					<!-- Step 1: Policy Stance -->
					<div class="box" x-show="currentStep === 1" x-cloak>
						<h2 class="title is-4">Organization AI Stance</h2>
						<p class="subtitle is-6 has-text-grey">Define your organization's overall approach to AI adoption</p>

						<!-- Inline validation message for this step -->
						<div class="notification is-danger is-light" x-show="saveError && (errorMessage.toLowerCase().includes('stance') || errorMessage.toLowerCase().includes('adoption'))" x-cloak>
							<button class="delete" @click="saveError = false"></button>
							<strong>Validation Error:</strong> <span x-text="errorMessage"></span>
						</div>

						<div class="field">
							<label class="label">Adoption Level</label>
							<div class="control">
								<div class="select is-fullwidth">
									<select x-model="policy.stance.adoption_level">
										<option value="conservative">Conservative - Cautious AI adoption with strict oversight</option>
										<option value="controlled">Controlled - Measured AI adoption with clear governance</option>
										<option value="progressive">Progressive - Active AI adoption with balanced controls</option>
										<option value="innovative">Innovative - Aggressive AI adoption, high experimentation</option>
									</select>
								</div>
							</div>
						</div>
							<div class="field">
								<label class="label">Risk Tolerance</label>
								<div class="control">
									<div class="select is-fullwidth">
										<select x-model="policy.stance.risk_tolerance">
											<option value="low">Low - Minimize AI-related risks</option>
											<option value="medium">Medium - Balance innovation with risk management</option>
											<option value="high">High - Accept higher risks for innovation</option>
										</select>
									</div>
								</div>
							</div>

							<div class="field">
								<label class="label">Compliance Frameworks</label>
								<div class="control">
									<label class="checkbox">
										<input type="checkbox" x-model="frameworksSelected.soc2"/> SOC 2
									</label>
								</div>
								<div class="control">
									<label class="checkbox">
										<input type="checkbox" x-model="frameworksSelected.gdpr"/> GDPR
									</label>
								</div>
								<div class="control">
									<label class="checkbox">
										<input type="checkbox" x-model="frameworksSelected.hipaa"/> HIPAA
									</label>
								</div>
								<div class="control">
									<label class="checkbox">
										<input type="checkbox" x-model="frameworksSelected.iso27001"/> ISO 27001
									</label>
								</div>
							</div>
						</div>

						<!-- Step 2: Model Policy -->
						<div class="box" x-show="currentStep === 2" x-cloak>
							<h2 class="title is-4">AI Models & Providers</h2>
							<p class="subtitle is-6 has-text-grey">Configure which AI models and providers are allowed</p>

							<!-- Inline validation message for this step -->
							<div class="notification is-danger is-light" x-show="saveError && errorMessage.toLowerCase().includes('provider')" x-cloak>
								<button class="delete" @click="saveError = false"></button>
								<strong>Validation Error:</strong> <span x-text="errorMessage"></span>
							</div>

							<div class="field">
								<label class="label">Fallback Behavior</label>
								<div class="control">
									<div class="select is-fullwidth">
										<select x-model="policy.models.fallback_behavior">
											<option value="fail_safe">Fail Safe - Block requests for unauthorized models</option>
											<option value="degrade">Degrade - Use alternative approved model</option>
											<option value="queue_for_review">Queue for Review - Pending manual approval</option>
										</select>
									</div>
								</div>
							</div>

							<div class="field">
								<label class="label">Allowed Providers</label>
								<template x-for="(provider, index) in policy.models.allowed_providers" :key="index">
									<div class="box mb-3">
										<div class="field">
											<label class="label">Provider Name</label>
											<div class="control">
												<input class="input" type="text" x-model="provider.provider" placeholder="e.g., OpenAI, Anthropic"/>
											</div>
										</div>

										<div class="field">
											<label class="label">Allowed Models (comma-separated)</label>
											<div class="control">
												<input class="input" type="text" x-model="provider.modelsText" @input="updateProviderModels(index)" placeholder="gpt-4, gpt-3.5-turbo"/>
											</div>
										</div>

										<div class="columns">
											<div class="column">
												<div class="field">
													<label class="label">Max Tokens/Request</label>
													<div class="control">
														<input class="input" type="number" x-model.number="provider.max_tokens_per_request" placeholder="4000"/>
													</div>
												</div>
											</div>
											<div class="column">
												<div class="field">
													<label class="label">Monthly Budget (USD)</label>
													<div class="control">
														<input class="input" type="number" step="0.01" x-model.number="provider.monthly_budget_usd" placeholder="1000.00"/>
													</div>
												</div>
											</div>
										</div>

										<div class="field">
											<button @click="removeProvider(index)" class="button is-small is-danger is-light">
												<span class="icon"><i class="fas fa-trash"></i></span>
												<span>Remove Provider</span>
											</button>
										</div>
									</div>
								</template>

								<button @click="addProvider()" class="button is-small is-primary is-light">
									<span class="icon"><i class="fas fa-plus"></i></span>
									<span>Add Provider</span>
								</button>
							</div>
						</div>

					<!-- Step 3: Autonomy Policy -->
					<div class="box" x-show="currentStep === 3" x-cloak>
						<h2 class="title is-4">Autonomy Levels</h2>
						<p class="subtitle is-6 has-text-grey">Define default autonomy and role-specific overrides</p>

						<!-- Inline validation message for this step -->
						<div class="notification is-danger is-light" x-show="saveError && (errorMessage.toLowerCase().includes('autonomy') || errorMessage.toLowerCase().includes('role'))" x-cloak>
							<button class="delete" @click="saveError = false"></button>
							<strong>Validation Error:</strong> <span x-text="errorMessage"></span>
						</div>

						<div class="field">
							<label class="label">Default Autonomy Level</label>
							<div class="control">
								<div class="select is-fullwidth">
									<select x-model="policy.autonomy.default_level">
										<option value="L0">L0 - Full Oversight (All decisions require approval)</option>
										<option value="L1">L1 - Assisted (AI recommends, human approves)</option>
										<option value="L2">L2 - Monitored (AI acts with oversight)</option>
										<option value="L3">L3 - Delegated (AI operates independently, humans intervene on exceptions)</option>
										<option value="L4">L4 - Autonomous (Fully autonomous AI operations)</option>
									</select>
								</div>
							</div>
							<p class="help">This applies to all roles unless overridden below</p>
						</div>
							<div class="field mt-5">
								<label class="label">Role-Specific Overrides</label>
								<p class="help mb-3">Configure custom autonomy levels for specific roles</p>

								<template x-for="(override, index) in policy.autonomy.role_overrides" :key="index">
									<div class="box mb-3">
										<div class="field">
											<label class="label">Role Name</label>
											<div class="control">
												<input class="input" type="text" x-model="override.role_name" placeholder="e.g., Financial Analyst"/>
											</div>
										</div>

										<div class="field">
											<label class="label">Autonomy Level</label>
											<div class="control">
												<div class="select is-fullwidth">
													<select x-model="override.level">
														<option value="L0">L0 - Full Oversight</option>
														<option value="L1">L1 - Assisted</option>
														<option value="L2">L2 - Monitored</option>
														<option value="L3">L3 - Delegated</option>
														<option value="L4">L4 - Autonomous</option>
													</select>
												</div>
											</div>
										</div>

										<div class="field">
											<label class="label">Justification</label>
											<div class="control">
												<textarea class="textarea" x-model="override.justification" placeholder="Explain why this role needs different autonomy..."></textarea>
											</div>
										</div>

										<div class="field">
											<button @click="removeRoleOverride(index)" class="button is-small is-danger is-light">
												<span class="icon"><i class="fas fa-trash"></i></span>
												<span>Remove Override</span>
											</button>
										</div>
									</div>
								</template>

								<button @click="addRoleOverride()" class="button is-small is-primary is-light">
									<span class="icon"><i class="fas fa-plus"></i></span>
									<span>Add Role Override</span>
								</button>
							</div>
						</div>

					<!-- Step 4: Data Access Policy -->
					<div class="box" x-show="currentStep === 4" x-cloak>
						<h2 class="title is-4">Data Access & Privacy</h2>
						<p class="subtitle is-6 has-text-grey">Control data access by classification level</p>

						<!-- Inline validation message for this step -->
						<div class="notification is-danger is-light" x-show="saveError && (errorMessage.toLowerCase().includes('data') || errorMessage.toLowerCase().includes('classification') || errorMessage.toLowerCase().includes('pii'))" x-cloak>
							<button class="delete" @click="saveError = false"></button>
							<strong>Validation Error:</strong> <span x-text="errorMessage"></span>
						</div>

						<div class="field">
							<label class="checkbox">
								<input type="checkbox" x-model="policy.data_access.classification_required"/>
								Require data classification before access
							</label>
						</div>
							<div class="field mt-4">
								<label class="label">PII Handling</label>
								<div class="field">
									<label class="checkbox">
										<input type="checkbox" x-model="policy.data_access.pii_handling.detect_pii"/>
										Auto-detect PII in data
									</label>
								</div>
								<div class="field">
									<label class="checkbox">
										<input type="checkbox" x-model="policy.data_access.pii_handling.anonymization_required"/>
										Require anonymization for PII
									</label>
								</div>
								<div class="field">
									<label class="checkbox">
										<input type="checkbox" x-model="policy.data_access.pii_handling.deletion_on_request"/>
										Support deletion on request (GDPR compliance)
									</label>
								</div>
							</div>

							<div class="field mt-4">
								<label class="label">Cross-Border Data Transfer</label>
								<div class="control">
									<div class="select is-fullwidth">
										<select x-model="policy.data_access.pii_handling.cross_border_transfer">
											<option value="allow">Allow - Permit cross-border transfers</option>
											<option value="deny">Deny - Block all cross-border transfers</option>
											<option value="require_approval">Require Approval - Case-by-case review</option>
										</select>
									</div>
								</div>
							</div>
						</div>

					<!-- Step 5: Actions & Risk -->
					<div class="box" x-show="currentStep === 5" x-cloak>
						<h2 class="title is-4">Actions & Risk Management</h2>
						<p class="subtitle is-6 has-text-grey">Configure action approvals and risk thresholds</p>

						<!-- Inline validation message for this step -->
						<div class="notification is-danger is-light" x-show="saveError && (errorMessage.toLowerCase().includes('action') || errorMessage.toLowerCase().includes('risk') || errorMessage.toLowerCase().includes('threshold'))" x-cloak>
							<button class="delete" @click="saveError = false"></button>
							<strong>Validation Error:</strong> <span x-text="errorMessage"></span>
						</div>

						<div class="field">
							<label class="label">Prohibited Actions (comma-separated patterns)</label>
							<div class="control">
								<input class="input" type="text" x-model="prohibitedActionsText" @input="updateProhibitedActions()" placeholder="delete_database, drop_table, execute_shell"/>
							</div>
							<p class="help">Use * for wildcards, e.g., delete_*</p>
						</div>
							<div class="field mt-4">
								<label class="checkbox">
									<input type="checkbox" x-model="policy.risk.scoring_enabled"/>
									Enable risk scoring
								</label>
							</div>

							<div x-show="policy.risk.scoring_enabled" class="mt-4">
								<label class="label">Risk Thresholds</label>
								<div class="columns">
									<div class="column">
										<div class="field">
											<label class="label">Low</label>
											<div class="control">
												<input class="input" type="number" x-model.number="policy.risk.thresholds.low" placeholder="25"/>
											</div>
										</div>
									</div>
									<div class="column">
										<div class="field">
											<label class="label">Medium</label>
											<div class="control">
												<input class="input" type="number" x-model.number="policy.risk.thresholds.medium" placeholder="50"/>
											</div>
										</div>
									</div>
									<div class="column">
										<div class="field">
											<label class="label">High</label>
											<div class="control">
												<input class="input" type="number" x-model.number="policy.risk.thresholds.high" placeholder="75"/>
											</div>
										</div>
									</div>
									<div class="column">
										<div class="field">
											<label class="label">Critical</label>
											<div class="control">
												<input class="input" type="number" x-model.number="policy.risk.thresholds.critical" placeholder="90"/>
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>

					<!-- Step 6: Compliance & Monitoring -->
					<div class="box" x-show="currentStep === 6" x-cloak>
						<h2 class="title is-4">Compliance & Monitoring</h2>
						<p class="subtitle is-6 has-text-grey">Configure audit requirements and monitoring</p>

						<!-- Inline validation message for this step -->
						<div class="notification is-danger is-light" x-show="saveError && (errorMessage.toLowerCase().includes('compliance') || errorMessage.toLowerCase().includes('audit') || errorMessage.toLowerCase().includes('monitoring'))" x-cloak>
							<button class="delete" @click="saveError = false"></button>
							<strong>Validation Error:</strong> <span x-text="errorMessage"></span>
						</div>

						<div class="field">
							<label class="label">Audit Requirements</label>
							<div class="field">
								<label class="checkbox">
									<input type="checkbox" x-model="policy.compliance.audit_requirements.log_all_actions"/>
									Log all AI actions
								</label>
							</div>
							<div class="field">
								<label class="checkbox">
									<input type="checkbox" x-model="policy.compliance.audit_requirements.immutable_audit_log"/>
									Use immutable audit log
								</label>
							</div>
						</div>

						<div class="field mt-4">
							<label class="label">Audit Retention (years)</label>
							<div class="control">
								<input class="input" type="number" x-model.number="policy.compliance.audit_requirements.retention_years" placeholder="7"/>
							</div>
						</div>
							<div class="field mt-4">
								<label class="label">Reporting Requirements</label>
								<div class="field">
									<label class="checkbox">
										<input type="checkbox" x-model="policy.compliance.reporting.daily_summary"/>
										Daily summary reports
									</label>
								</div>
								<div class="field">
									<label class="checkbox">
										<input type="checkbox" x-model="policy.compliance.reporting.weekly_compliance_report"/>
										Weekly compliance reports
									</label>
								</div>
								<div class="field">
									<label class="checkbox">
										<input type="checkbox" x-model="policy.compliance.reporting.quarterly_risk_assessment"/>
										Quarterly risk assessments
									</label>
								</div>
							</div>

							<div class="field mt-4">
								<label class="label">Real-Time Monitoring</label>
								<div class="field">
									<label class="checkbox">
										<input type="checkbox" x-model="policy.monitoring.real_time_policy_violations"/>
										Monitor policy violations in real-time
									</label>
								</div>
							</div>
						</div>

						<!-- Navigation Buttons -->
						<div class="field is-grouped is-grouped-centered mt-5">
							<p class="control">
								<button @click="previousStep()" class="button" :disabled="currentStep === 1">
									<span class="icon"><i class="fas fa-arrow-left"></i></span>
									<span>Previous</span>
								</button>
							</p>
							<p class="control" x-show="currentStep < 6">
								<button @click="nextStep()" class="button is-primary">
									<span>Next</span>
									<span class="icon"><i class="fas fa-arrow-right"></i></span>
								</button>
							</p>
							<p class="control" x-show="currentStep === 6">
								<button @click="savePolicy()" class="button is-success" :disabled="saving || !isValid()">
									<span class="icon"><i class="fas fa-check"></i></span>
									<span x-text="saving ? 'Saving...' : 'Save Policy'">Save Policy</span>
								</button>
							</p>
						</div>
					</div>
				</div>

				<!-- Save Success Notification -->
				<div class="notification is-success is-light" x-show="saveSuccess" x-cloak style="position: fixed; top: 20px; right: 20px; z-index: 1000;">
					<button class="delete" @click="saveSuccess = false"></button>
					Policy saved successfully!
				</div>

				<!-- Save Error Notification -->
				<div class="notification is-danger is-light" x-show="saveError" x-cloak style="position: fixed; top: 20px; right: 20px; z-index: 1000;">
					<button class="delete" @click="saveError = false"></button>
					<span x-text="errorMessage">Failed to save policy</span>
				</div>
			</div>
		</body>
	</html>
}
