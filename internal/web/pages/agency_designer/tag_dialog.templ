package agency_designer

// TagDialog renders the modal dialog for creating agency tags
// Tags are immutable snapshots for checkpointing, releases, or experimentation
templ TagDialog() {
	<div class="modal" id="tag-dialog">
		<div class="modal-background" onclick="closeTagDialog()"></div>
		<div class="modal-card">
			<header class="modal-card-head">
				<p class="modal-card-title">
					<span class="icon-text">
						<span class="icon">
							<i class="fas fa-tag"></i>
						</span>
						<span>Create Agency Tag</span>
					</span>
				</p>
				<button class="delete" aria-label="close" onclick="closeTagDialog()"></button>
			</header>
			
			<section class="modal-card-body">
				<div class="notification is-info is-light">
					<p class="is-size-7">
						<span class="icon"><i class="fas fa-info-circle"></i></span>
						Tags create immutable snapshots of your agency's current state. 
						Use them for versioning, checkpoints, or experimental branches.
					</p>
				</div>
				
				<!-- Tag Name -->
				<div class="field">
					<label class="label">Tag Name *</label>
					<div class="control has-icons-left">
						<input 
							class="input" 
							type="text" 
							id="tag-name"
							placeholder="v1.0.0-release"
							pattern="^[a-zA-Z0-9._-]+$"
							required>
						<span class="icon is-small is-left">
							<i class="fas fa-tag"></i>
						</span>
					</div>
					<p class="help">Alphanumeric with dots, dashes, underscores (e.g., v1.0.0-release, checkpoint-2024-01)</p>
				</div>
				
				<!-- Tag Type -->
				<div class="field">
					<label class="label">Tag Type *</label>
					<div class="control has-icons-left">
						<div class="select is-fullwidth">
							<select id="tag-type" onchange="updateTagTypeHelp()">
								<option value="release">Release - Production-ready version</option>
								<option value="snapshot">Snapshot - Point-in-time backup</option>
								<option value="experimental">Experimental - Testing changes</option>
								<option value="checkpoint">Checkpoint - Stable state marker</option>
							</select>
						</div>
						<span class="icon is-small is-left">
							<i class="fas fa-bookmark"></i>
						</span>
					</div>
					<p class="help" id="tag-type-help">
						Production-ready versions intended for deployment
					</p>
				</div>
				
				<!-- Version (optional, recommended for releases) -->
				<div class="field">
					<label class="label">Version</label>
					<div class="control has-icons-left">
						<input 
							class="input" 
							type="text" 
							id="tag-version"
							placeholder="1.0.0"
							pattern="^\d+\.\d+\.\d+(-[a-zA-Z0-9.-]+)?$">
						<span class="icon is-small is-left">
							<i class="fas fa-code-branch"></i>
						</span>
					</div>
					<p class="help">Semantic version (optional but recommended for release tags)</p>
				</div>
				
				<!-- Description -->
				<div class="field">
					<label class="label">Description *</label>
					<div class="control">
						<textarea 
							class="textarea" 
							id="tag-description"
							placeholder="Describe the purpose of this tag..."
							rows="3"
							required></textarea>
					</div>
				</div>
				
				<!-- Metadata (advanced, collapsible) -->
				<div class="field">
					<div class="control">
						<label class="checkbox">
							<input 
								type="checkbox" 
								id="tag-show-metadata"
								onchange="toggleMetadataFields()">
							<span class="ml-2">Add custom metadata (advanced)</span>
						</label>
					</div>
				</div>
				
				<div id="tag-metadata-fields" style="display: none;">
					<div class="box" style="background-color: #fafafa;">
						<p class="has-text-weight-semibold mb-3">Custom Metadata</p>
						
						<!-- Key-value pairs for metadata -->
						<div id="metadata-pairs">
							<!-- Dynamically added metadata fields go here -->
						</div>
						
						<button 
							class="button is-small is-light"
							type="button"
							onclick="addMetadataField()">
							<span class="icon"><i class="fas fa-plus"></i></span>
							<span>Add Metadata Field</span>
						</button>
					</div>
				</div>
				
				<!-- Tag Preview -->
				<div class="box mt-4" style="background-color: #f5f5f5;">
					<p class="has-text-weight-semibold mb-2">Tag Preview</p>
					<div class="content is-small">
						<p><strong>Name:</strong> <span id="preview-tag-name-text">-</span></p>
						<p><strong>Type:</strong> <span id="preview-tag-type">Release</span></p>
						<p><strong>Version:</strong> <span id="preview-tag-version">-</span></p>
						<p><strong>Description:</strong> <span id="preview-tag-description">-</span></p>
						<p><strong>Created:</strong> <span id="preview-tag-timestamp">Just now</span></p>
					</div>
				</div>
			</section>
			
			<footer class="modal-card-foot">
				<div class="buttons">
					<button 
						class="button is-link"
						id="confirm-tag-btn"
						onclick="handleTagSubmit()">
						<span class="icon"><i class="fas fa-tag"></i></span>
						<span>Create Tag</span>
					</button>
					<button class="button" onclick="closeTagDialog()">Cancel</button>
				</div>
				<div id="tag-progress" class="is-flex-grow-1" style="display: none;">
					<progress class="progress is-link" max="100"></progress>
					<p class="help">Creating tag...</p>
				</div>
			</footer>
		</div>
	</div>
}
