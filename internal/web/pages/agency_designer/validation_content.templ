package agency_designer

import (
	"github.com/aosanya/CodeValdCortex/internal/agency/models"
)

// ValidationContent renders the validation results section
templ ValidationContent(currentAgency *models.Agency) {
	<div class="overview-section">
		<div class="box">
			<h4 class="title is-5 mb-4">
				<span class="icon-text">
					<span class="icon has-text-info">
						<i class="fas fa-check-circle"></i>
					</span>
					<span>Agency Validation</span>
				</span>
			</h4>
			
			<!-- Validation Results Container -->
			<div id="validation-results">
				<div class="notification is-info is-light">
					<p class="mb-2"><strong>Ready to validate</strong></p>
					<p class="is-size-7">Click the "Validate" button in the toolbar above to check if your agency specification is complete and ready for publishing.</p>
				</div>
			</div>
			
			<!-- Requirements Checklist -->
			<div class="content mt-5">
				<h5 class="title is-6">Validation Requirements</h5>
				<p class="is-size-7 has-text-grey mb-3">Your agency must meet the following requirements to pass validation:</p>
				<ul class="is-size-7">
					<li><strong>Introduction:</strong> Agency name, description, and purpose must be defined</li>
					<li><strong>Goals:</strong> At least one goal must be defined</li>
					<li><strong>Roles:</strong> At least one role must be defined</li>
					<li><strong>Work Items:</strong> At least one work item should be defined (recommended)</li>
					<li><strong>Workflows:</strong> At least one workflow must be defined</li>
					<li><strong>RACI Matrix:</strong> Role assignments should be defined for work items</li>
				</ul>
			</div>
		</div>
	</div>
}
