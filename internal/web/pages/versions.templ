package pages

import (
	"github.com/aosanya/CodeValdCortex/internal/agency/models"
	"github.com/aosanya/CodeValdCortex/internal/web/components"
	"github.com/aosanya/CodeValdCortex/internal/web/pages/agency_designer"
)

templ VersionsPage(agency *models.Agency) {
	@components.LayoutWithAgency("Versions", agency) {
		<!-- Page-specific JavaScript -->
		<script src="/static/js/agency-designer/tags.js"></script>
		<script src="/static/js/agency-designer/instances.js"></script>
		<script>
			// Initialize on page load
			document.addEventListener('DOMContentLoaded', function() {
				// Load tags when page loads
				if (typeof loadTags === 'function') {
					loadTags();
				}
			});
		</script>
		
		<!-- Page Header -->
		<div class="mb-6">
			<div class="level">
				<div class="level-left">
					<div class="level-item">
						<div>
							<h1 class="title is-2 mb-2">
								<span class="icon-text">
									<span class="icon has-text-info">
										<i class="fas fa-tags"></i>
									</span>
									<span>Agency Versions</span>
								</span>
							</h1>
							<p class="subtitle is-5 has-text-grey mt-0">
								Manage tags and instances for <strong>{ agency.Name }</strong>
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
		
		<!-- Info Box -->
		<div class="notification is-info is-light mb-5">
			<p class="is-size-6">
				<span class="icon"><i class="fas fa-info-circle"></i></span>
				<strong>Tags</strong> are immutable snapshots of your agency configuration. 
				Create multiple <strong>instances</strong> from any tag for testing, staging, or production.
			</p>
		</div>
		
		<!-- Tags List Card -->
		<div class="box">
			@agency_designer.TagsListCard()
		</div>
		
		<!-- Tag Dialog -->
		@agency_designer.TagDialog()
		
		<!-- Start Instance Dialog -->
		@agency_designer.StartInstanceDialog()
	}
}
