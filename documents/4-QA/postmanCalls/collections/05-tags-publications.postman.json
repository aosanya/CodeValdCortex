{
    "info": {
        "_postman_id": "tags-publications-005",
        "name": "CodeValdCortex - Tags & Publications",
        "description": "Tag management and publication lifecycle endpoints (MVP-PUB-003, MVP-PUB-004).\n\n**Authentication Required:** All endpoints require Bearer token authentication (MVP-AUTH-005).\n\n**Prerequisites:**\n1. Register user via 00-authentication collection\n2. Login to get access token\n3. Set {{access_token}} variable in environment\n\n**Security:**\n- All routes protected by auth middleware\n- Agency-scoped access control",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{access_token}}",
                "type": "string"
            }
        ]
    },
    "item": [
        {
            "name": "Tags",
            "description": "Tag creation, listing, and restoration",
            "item": [
                {
                    "name": "Create Tag",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"v1.0.0\",\n  \"description\": \"First production release\",\n  \"metadata\": {\n    \"release_notes\": \"Initial stable version\"\n  }\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/agencies/:id/tags",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "agencies",
                                ":id",
                                "tags"
                            ],
                            "variable": [
                                {
                                    "key": "id",
                                    "value": "{{agency_id}}"
                                }
                            ]
                        },
                        "description": "Create a new tag (snapshot) of the current agency state"
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 201\", function () {",
                                    "    pm.response.to.have.status(201);",
                                    "});",
                                    "",
                                    "pm.test(\"Tag created successfully\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData).to.have.property('name');",
                                    "    pm.environment.set('tag_name', jsonData.name);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "List Tags",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/v1/agencies/:id/tags",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "agencies",
                                ":id",
                                "tags"
                            ],
                            "variable": [
                                {
                                    "key": "id",
                                    "value": "{{agency_id}}"
                                }
                            ]
                        },
                        "description": "List all tags for an agency"
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 200\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test(\"Response is array\", function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData).to.be.an('array');",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "Get Tag Details",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/v1/agencies/:id/tags/:name",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "agencies",
                                ":id",
                                "tags",
                                ":name"
                            ],
                            "variable": [
                                {
                                    "key": "id",
                                    "value": "{{agency_id}}"
                                },
                                {
                                    "key": "name",
                                    "value": "{{tag_name}}"
                                }
                            ]
                        },
                        "description": "Get detailed information about a specific tag"
                    },
                    "response": []
                },
                {
                    "name": "Delete Tag",
                    "request": {
                        "method": "DELETE",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/v1/agencies/:id/tags/:name",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "agencies",
                                ":id",
                                "tags",
                                ":name"
                            ],
                            "variable": [
                                {
                                    "key": "id",
                                    "value": "{{agency_id}}"
                                },
                                {
                                    "key": "name",
                                    "value": "{{tag_name}}"
                                }
                            ]
                        },
                        "description": "Delete a tag (does not affect running instances)"
                    },
                    "response": []
                },
                {
                    "name": "Restore from Tag",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/v1/agencies/:id/tags/:name/restore",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "agencies",
                                ":id",
                                "tags",
                                ":name",
                                "restore"
                            ],
                            "variable": [
                                {
                                    "key": "id",
                                    "value": "{{agency_id}}"
                                },
                                {
                                    "key": "name",
                                    "value": "{{tag_name}}"
                                }
                            ]
                        },
                        "description": "Restore agency state from a tag (rollback)"
                    },
                    "response": []
                },
                {
                    "name": "Compare Tags",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/v1/tags/:tag1/compare/:tag2",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "tags",
                                ":tag1",
                                "compare",
                                ":tag2"
                            ],
                            "variable": [
                                {
                                    "key": "tag1",
                                    "value": "v1.0.0"
                                },
                                {
                                    "key": "tag2",
                                    "value": "v1.1.0"
                                }
                            ]
                        },
                        "description": "Compare differences between two tags"
                    },
                    "response": []
                }
            ]
        },
