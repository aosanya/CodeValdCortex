{
    "info": {
        "_postman_id": "instances-004",
        "name": "CodeValdCortex - Instances",
        "description": "Instance lifecycle management endpoints (MVP-PUB-007) - start, stop, restart, health checks.\n\n**Authentication Required:** All endpoints require Bearer token authentication (MVP-AUTH-005).\n\n**Prerequisites:**\n1. Register user via 00-authentication collection\n2. Login to get access token\n3. Set {{access_token}} variable in environment\n\n**Security:**\n- All routes protected by auth middleware\n- Users can only access instances of their own agencies",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{access_token}}",
                "type": "string"
            }
        ]
    },
    "item": [
        {
            "name": "Start Instance from Tag",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"name\": \"Production Instance\",\n  \"config\": {\n    \"environment\": \"production\",\n    \"replicas\": 1\n  }\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{base_url}}/api/v1/agencies/:id/tags/:name/instances",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "v1",
                        "agencies",
                        ":id",
                        "tags",
                        ":name",
                        "instances"
                    ],
                    "variable": [
                        {
                            "key": "id",
                            "value": "{{agency_id}}"
                        },
                        {
                            "key": "name",
                            "value": "{{tag_name}}",
                            "description": "Tag name to create instance from (e.g., v1.0.0)"
                        }
                    ]
                },
                "description": "Start a new instance from a published tag"
            },
            "response": [],
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test(\"Status code is 201\", function () {",
                            "    pm.response.to.have.status(201);",
                            "});",
                            "",
                            "pm.test(\"Instance created successfully\", function () {",
                            "    var jsonData = pm.response.json();",
                            "    pm.expect(jsonData).to.have.property('instance_id');",
                            "    pm.environment.set('instance_id', jsonData.instance_id);",
                            "});"
                        ],
                        "type": "text/javascript"
                    }
                }
            ]
        },
