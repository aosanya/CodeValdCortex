{
    "info": {
        "_postman_id": "work-items-003",
        "name": "CodeValdCortex - Work Items (Issues)",
        "description": "Work item (issue) management endpoints with pagination, filtering, and assignment operations (MVP-WI-008, MVP-RM-003)",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "List Issues with Pagination",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Origin",
                        "value": "http://localhost:5173",
                        "type": "text",
                        "description": "For CORS testing"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/api/v1/agencies/:id/instances/:instance_id/issues?limit=10&offset=0&status=open&assignee=",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "v1",
                        "agencies",
                        ":id",
                        "instances",
                        ":instance_id",
                        "issues"
                    ],
                    "query": [
                        {
                            "key": "limit",
                            "value": "10",
                            "description": "Number of items per page (MVP-RM-003)"
                        },
                        {
                            "key": "offset",
                            "value": "0",
                            "description": "Number of items to skip (MVP-RM-003)"
                        },
                        {
                            "key": "status",
                            "value": "open",
                            "description": "Filter by status (open, in-progress, completed, etc.)"
                        },
                        {
                            "key": "assignee",
                            "value": "",
                            "description": "Filter by assignee agent key"
                        }
                    ],
                    "variable": [
                        {
                            "key": "id",
                            "value": "{{agency_id}}"
                        },
                        {
                            "key": "instance_id",
                            "value": "{{instance_id}}"
                        }
                    ]
                },
                "description": "List all issues for an instance with pagination and filtering support (MVP-RM-003)"
            },
            "response": [],
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test(\"Status code is 200\", function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "pm.test(\"CORS headers present\", function () {",
                            "    pm.response.to.have.header(\"Access-Control-Allow-Origin\");",
                            "});",
                            "",
                            "pm.test(\"Response has pagination metadata\", function () {",
                            "    var jsonData = pm.response.json();",
                            "    pm.expect(jsonData).to.have.property('pagination');",
                            "    pm.expect(jsonData.pagination).to.have.property('total');",
                            "    pm.expect(jsonData.pagination).to.have.property('limit');",
                            "    pm.expect(jsonData.pagination).to.have.property('offset');",
                            "    pm.expect(jsonData.pagination).to.have.property('hasMore');",
                            "});",
                            "",
                            "pm.test(\"Response has data array\", function () {",
                            "    var jsonData = pm.response.json();",
                            "    pm.expect(jsonData).to.have.property('data');",
                            "    pm.expect(jsonData.data).to.be.an('array');",
                            "});"
                        ],
                        "type": "text/javascript"
                    }
                }
            ]
        },
