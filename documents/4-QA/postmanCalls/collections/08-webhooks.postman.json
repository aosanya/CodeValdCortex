                        "value": "pull_request",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"action\": \"closed\",\n  \"number\": 42,\n  \"pull_request\": {\n    \"id\": 789,\n    \"number\": 42,\n    \"title\": \"Feature: Add user authentication\",\n    \"state\": \"closed\",\n    \"merged\": true,\n    \"merged_at\": \"2026-01-26T14:00:00Z\",\n    \"merge_commit_sha\": \"merged123abc456\"\n  },\n  \"repository\": {\n    \"name\": \"project-repo\",\n    \"full_name\": \"organization/project-repo\"\n  }\n}",
                    "options": {
