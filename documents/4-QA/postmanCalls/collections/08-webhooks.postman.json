{
    "info": {
        "_postman_id": "webhooks-008",
        "name": "CodeValdCortex - Webhooks",
        "description": "Gitea webhook integration endpoints for work item synchronization and pull request automation",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Issue Webhook",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json",
                        "type": "text"
                    },
                    {
                        "key": "X-Gitea-Event",
                        "value": "issues",
                        "type": "text",
                        "description": "Gitea event type header"
                    },
                    {
                        "key": "X-Gitea-Signature",
                        "value": "sha256=signature_here",
                        "type": "text",
                        "description": "Webhook signature for verification"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"action\": \"opened\",\n  \"number\": 123,\n  \"issue\": {\n    \"id\": 456,\n    \"number\": 123,\n    \"title\": \"Bug: Application crashes on startup\",\n    \"body\": \"Detailed description of the issue...\",\n    \"state\": \"open\",\n    \"labels\": [\n      {\n        \"id\": 1,\n        \"name\": \"bug\"\n      },\n      {\n        \"id\": 2,\n        \"name\": \"priority:high\"\n      }\n    ],\n    \"assignee\": {\n      \"id\": 789,\n      \"login\": \"developer1\",\n      \"email\": \"developer1@example.com\"\n    },\n    \"created_at\": \"2026-01-26T10:00:00Z\",\n    \"updated_at\": \"2026-01-26T10:00:00Z\"\n  },\n  \"repository\": {\n    \"id\": 1,\n    \"name\": \"project-repo\",\n    \"full_name\": \"organization/project-repo\",\n    \"owner\": {\n      \"login\": \"organization\"\n    }\n  },\n  \"sender\": {\n    \"id\": 999,\n    \"login\": \"user1\",\n    \"email\": \"user1@example.com\"\n  }\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{base_url}}/api/v1/work/issues",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "v1",
                        "work",
                        "issues"
                    ]
                },
                "description": "Gitea webhook endpoint for issue events (created, updated, closed, reopened, assigned, etc.)"
            },
            "response": [],
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test(\"Status code is 200 or 202\", function () {",
                            "    pm.expect(pm.response.code).to.be.oneOf([200, 202]);",
                            "});",
                            "",
                            "pm.test(\"Webhook processed successfully\", function () {",
                            "    var jsonData = pm.response.json();",
                            "    pm.expect(jsonData).to.have.property('status');",
                            "    pm.expect(jsonData.status).to.be.oneOf(['processed', 'queued']);",
                            "});"
                        ],
                        "type": "text/javascript"
                    }
                }
            ]
        },
