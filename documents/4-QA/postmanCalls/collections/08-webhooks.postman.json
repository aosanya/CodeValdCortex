        {
            "name": "Pull Request Webhook",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json",
                        "type": "text"
                    },
                    {
                        "key": "X-Gitea-Event",
                        "value": "pull_request",
                        "type": "text"
                    },
                    {
                        "key": "X-Gitea-Signature",
                        "value": "sha256=signature_here",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"action\": \"opened\",\n  \"number\": 42,\n  \"pull_request\": {\n    \"id\": 789,\n    \"number\": 42,\n    \"title\": \"Feature: Add user authentication\",\n    \"body\": \"Implements OAuth2 authentication\",\n    \"state\": \"open\",\n    \"head\": {\n      \"ref\": \"feature/auth\",\n      \"sha\": \"abc123def456\"\n    },\n    \"base\": {\n      \"ref\": \"main\",\n      \"sha\": \"xyz789uvw012\"\n    },\n    \"user\": {\n      \"id\": 999,\n      \"login\": \"developer1\"\n    },\n    \"created_at\": \"2026-01-26T10:30:00Z\",\n    \"updated_at\": \"2026-01-26T10:30:00Z\"\n  },\n  \"repository\": {\n    \"id\": 1,\n    \"name\": \"project-repo\",\n    \"full_name\": \"organization/project-repo\"\n  },\n  \"sender\": {\n    \"id\": 999,\n    \"login\": \"developer1\"\n  }\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{base_url}}/api/v1/work/pull-requests",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "v1",
                        "work",
                        "pull-requests"
                    ]
                },
                "description": "Gitea webhook endpoint for pull request events (opened, closed, synchronized, etc.)"
            },
            "response": [],
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test(\"Status code is 200 or 202\", function () {",
                            "    pm.expect(pm.response.code).to.be.oneOf([200, 202]);",
                            "});",
                            "",
                            "pm.test(\"PR webhook processed\", function () {",
                            "    var jsonData = pm.response.json();",
                            "    pm.expect(jsonData).to.have.property('status');",
                            "});"
                        ],
                        "type": "text/javascript"
                    }
                }
            ]
        },
        {
            "name": "Pull Request Webhook - Merged",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json",
                        "type": "text"
                    },
                    {
