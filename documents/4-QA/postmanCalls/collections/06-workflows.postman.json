        {
            "name": "Duplicate Workflow",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"newName\": \"Copy of Data Processing Workflow\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{base_url}}/api/v1/workflows/:id/duplicate",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
