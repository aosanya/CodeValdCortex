{
    "info": {
        "_postman_id": "workflows-006",
        "name": "CodeValdCortex - Workflows",
        "description": "Workflow CRUD operations, validation, and duplication endpoints",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Create Workflow",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"name\": \"Data Processing Workflow\",\n  \"description\": \"Process incoming data through validation and storage\",\n  \"steps\": [\n    {\n      \"id\": \"step-1\",\n      \"name\": \"Validate Input\",\n      \"type\": \"validation\",\n      \"config\": {}\n    },\n    {\n      \"id\": \"step-2\",\n      \"name\": \"Store Data\",\n      \"type\": \"storage\",\n      \"config\": {}\n    }\n  ],\n  \"triggers\": [\n    {\n      \"type\": \"webhook\",\n      \"config\": {}\n    }\n  ]\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{base_url}}/api/v1/agencies/:id/workflows",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "v1",
                        "agencies",
                        ":id",
                        "workflows"
                    ],
                    "variable": [
                        {
                            "key": "id",
                            "value": "{{agency_id}}"
                        }
                    ]
                },
                "description": "Create a new workflow for an agency"
            },
            "response": [],
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test(\"Status code is 201\", function () {",
                            "    pm.response.to.have.status(201);",
                            "});",
                            "",
                            "pm.test(\"Workflow created successfully\", function () {",
                            "    var jsonData = pm.response.json();",
                            "    pm.expect(jsonData).to.have.property('id');",
                            "    pm.environment.set('workflow_id', jsonData.id);",
                            "});"
                        ],
                        "type": "text/javascript"
                    }
                }
            ]
        },
