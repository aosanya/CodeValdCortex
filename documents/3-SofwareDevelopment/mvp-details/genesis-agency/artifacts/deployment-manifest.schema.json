{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://codevaldcortex.io/schemas/deployment-manifest.json",
    "title": "Agency Deployment Manifest",
    "description": "Complete deployment configuration for a new agency",
    "type": "object",
    "required": [
        "agency_id",
        "name",
        "version",
        "generated_at",
        "specification_file",
        "database_init_file",
        "deployment_steps"
    ],
    "properties": {
        "agency_id": {
            "type": "string",
            "pattern": "^agency_[a-f0-9]{32}$",
            "description": "Unique agency identifier"
        },
        "name": {
            "type": "string",
            "description": "Human-readable agency name"
        },
        "display_name": {
            "type": "string",
            "description": "Display name with emoji"
        },
        "category": {
            "type": "string",
            "description": "Agency category"
        },
        "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "description": "Semantic version"
        },
        "description": {
            "type": "string",
            "description": "Brief agency description"
        },
        "generated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Generation timestamp"
        },
        "generated_by": {
            "type": "string",
            "default": "genesis-agency",
            "description": "Genesis Agency identifier"
        },
        "specification_file": {
            "type": "string",
            "description": "Path to agency specification JSON file"
        },
        "database_init_file": {
            "type": "string",
            "description": "Path to database initialization JSON file"
        },
        "deployment_steps": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": [
                    "step_number",
                    "action",
                    "description"
                ],
                "properties": {
                    "step_number": {
                        "type": "integer",
                        "minimum": 1,
                        "description": "Sequential step number"
                    },
                    "action": {
                        "type": "string",
                        "enum": [
                            "create_agency_record",
                            "initialize_database",
                            "upload_specification",
                            "create_collections",
                            "run_seed_data",
                            "set_agency_state",
                            "verify_deployment"
                        ],
                        "description": "Deployment action to perform"
                    },
                    "description": {
                        "type": "string",
                        "description": "What this step does"
                    },
                    "api_endpoint": {
                        "type": "string",
                        "description": "API endpoint to call (if applicable)"
                    },
                    "http_method": {
                        "type": "string",
                        "enum": [
                            "GET",
                            "POST",
                            "PUT",
                            "DELETE"
                        ],
                        "description": "HTTP method (if API call)"
                    },
                    "request_body": {
                        "type": "object",
                        "description": "Request body template (if API call)"
                    },
                    "expected_status_code": {
                        "type": "integer",
                        "description": "Expected HTTP status code for success"
                    },
                    "rollback_action": {
                        "type": "string",
                        "description": "How to rollback if this step fails"
                    },
                    "automated": {
                        "type": "boolean",
                        "default": true,
                        "description": "Whether step can be automated"
                    },
                    "requires_approval": {
                        "type": "boolean",
                        "default": false,
                        "description": "Whether human approval is needed"
                    }
                }
            }
        },
        "pre_deployment_checks": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "check_name",
                    "description"
                ],
                "properties": {
                    "check_name": {
                        "type": "string",
                        "description": "Name of the check"
                    },
                    "description": {
                        "type": "string",
                        "description": "What is being checked"
                    },
                    "automated": {
                        "type": "boolean",
                        "default": true
                    }
                }
            },
            "description": "Checks to run before deployment"
        },
        "post_deployment_verification": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "check_name",
                    "description"
                ],
                "properties": {
                    "check_name": {
                        "type": "string",
                        "description": "Name of the verification"
                    },
                    "description": {
                        "type": "string",
                        "description": "What to verify"
                    },
                    "api_endpoint": {
                        "type": "string",
                        "description": "API endpoint to check"
                    },
                    "expected_result": {
                        "type": "string",
                        "description": "Expected result description"
                    }
                }
            },
            "description": "Verifications to run after deployment"
        },
        "rollback_plan": {
            "type": "object",
            "properties": {
                "steps": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "step_number": {
                                "type": "integer"
                            },
                            "action": {
                                "type": "string"
                            },
                            "description": {
                                "type": "string"
                            }
                        }
                    }
                },
                "data_backup_required": {
                    "type": "boolean",
                    "default": true
                }
            },
            "description": "How to rollback deployment if it fails"
        },
        "metadata": {
            "type": "object",
            "properties": {
                "research_session_id": {
                    "type": "string",
                    "description": "Genesis Agency research session ID"
                },
                "validation_passed": {
                    "type": "boolean",
                    "description": "Whether specification passed validation"
                },
                "human_approved_by": {
                    "type": "string",
                    "description": "User ID who approved deployment"
                },
                "deployment_notes": {
                    "type": "string",
                    "description": "Additional deployment notes"
                }
            }
        }
    },
    "examples": [
        {
            "agency_id": "agency_a1b2c3d4e5f6789012345678901234ab",
            "name": "Water Distribution Network",
            "display_name": "💧 Water Distribution",
            "category": "infrastructure",
            "version": "1.0.0",
            "description": "Smart water infrastructure monitoring and management",
            "generated_at": "2026-01-30T10:00:00Z",
            "generated_by": "genesis-agency",
            "specification_file": "artifacts/agency-specification.json",
            "database_init_file": "artifacts/database-init.json",
            "deployment_steps": [
                {
                    "step_number": 1,
                    "action": "create_agency_record",
                    "description": "Create agency record in platform database",
                    "api_endpoint": "/api/v1/agencies",
                    "http_method": "POST",
                    "expected_status_code": 201,
                    "automated": true,
                    "requires_approval": false
                },
                {
                    "step_number": 2,
                    "action": "initialize_database",
                    "description": "Initialize agency-specific database",
                    "automated": true,
                    "requires_approval": false
                },
                {
                    "step_number": 3,
                    "action": "upload_specification",
                    "description": "Upload agency specification",
                    "api_endpoint": "/api/v1/agencies/{id}/specification",
                    "http_method": "POST",
                    "expected_status_code": 201,
                    "automated": true,
                    "requires_approval": false
                },
                {
                    "step_number": 4,
                    "action": "set_agency_state",
                    "description": "Set agency state to 'draft'",
                    "automated": true,
                    "requires_approval": false
                },
                {
                    "step_number": 5,
                    "action": "verify_deployment",
                    "description": "Verify agency is accessible",
                    "api_endpoint": "/api/v1/agencies/{id}",
                    "http_method": "GET",
                    "expected_status_code": 200,
                    "automated": true,
                    "requires_approval": false
                }
            ],
            "pre_deployment_checks": [
                {
                    "check_name": "specification_validation",
                    "description": "Validate specification against schema",
                    "automated": true
                },
                {
                    "check_name": "database_name_available",
                    "description": "Check database name is not already in use",
                    "automated": true
                }
            ],
            "post_deployment_verification": [
                {
                    "check_name": "agency_accessible",
                    "description": "Agency retrievable via API",
                    "api_endpoint": "/api/v1/agencies/{id}",
                    "expected_result": "200 OK with agency data"
                },
                {
                    "check_name": "specification_retrievable",
                    "description": "Specification retrievable",
                    "api_endpoint": "/api/v1/agencies/{id}/specification",
                    "expected_result": "200 OK with complete specification"
                },
                {
                    "check_name": "database_exists",
                    "description": "Agency database created",
                    "expected_result": "Database exists in ArangoDB"
                }
            ],
            "metadata": {
                "validation_passed": true,
                "human_approved_by": "user-123",
                "deployment_notes": "Initial deployment from Genesis Agency"
            }
        }
    ]
}