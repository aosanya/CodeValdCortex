                "content": "Design specification"
              }
            ],
            "uses_services": [
              {
                "id": "comm_002_svc_001",
                "title": "IntroductionBuilder",
                "content": "AI service for generating introductions"
              },
              {
                "id": "comm_002_svc_002",
                "title": "GoalsBuilder",
                "content": "AI service for generating goals"
              }
            ]
          },
          "autonomy_boundaries": {
            "autonomous": [
              {
                "id": "auto_002_001",
                "title": "Content Generation",
                "content": "Drafting content and calling AI services"
