{
  "roles": {
    "title": "Role Specifications",
    "content": [
      {
        "id": "role_001",
        "title": "R-001: Requirements Analyst",
        "content": {
          "code": "requirements-analyst",
          "autonomy_level": "L2",
          "autonomy_description": "Conditional Autonomy",
          "capability_tags": [
            "research",
            "qa",
            "analysis",
            "documentation"
          ],
          "description": "Conducts structured research sessions with domain experts using the research prompt framework. Asks targeted questions to extract business requirements, stakeholder needs, and domain constraints.",
          "token_budget": 8000,
          "token_budget_unit": "tokens/conversation",
          "primary_llm": "GPT-4 or Claude Sonnet",
          "deliverables": [
            {
              "id": "deliv_001_001",
              "title": "Requirements Document",
              "content": "Complete requirements with Q&A transcript"
            },
            {
              "id": "deliv_001_002",
              "title": "Gap Analysis Report",
              "content": "Identified gaps and inconsistencies"
            },
            {
              "id": "deliv_001_003",
              "title": "Stakeholder Identification",
              "content": "Identified stakeholders and processes"
            },
            {
              "id": "deliv_001_004",
              "title": "Domain Vocabulary",
              "content": "Domain-specific vocabulary and terminology"
            },
            {
              "id": "deliv_001_005",
              "title": "Success Criteria",
              "content": "Success criteria definitions"
            }
          ],
          "communication_patterns": {
            "receives_from": [
              {
                "id": "comm_001_in_001",
                "title": "User (Domain Expert)",
                "content": "Domain knowledge and business requirements"
              }
            ],
            "sends_to": [
              {
                "id": "comm_001_out_001",
                "title": "Specification Designer",
                "content": "Requirements synthesis"
              }
            ],
            "collaborates_with": [
              {
                "id": "comm_001_collab_001",
                "title": "Quality Validator",
                "content": "Gap resolution and completeness validation"
              }
            ]
          },
          "autonomy_boundaries": {
            "autonomous": [
              {
                "id": "auto_001_001",
                "title": "Question Generation",
                "content": "Asking questions and tracking conversation state"
              }
            ],
            "requires_approval": [
              {
                "id": "approve_001_001",
                "title": "Session Completion",
                "content": "Concluding research session and marking requirements complete"
              }
            ]
          },
          "work_items": [
            "WI-001",
            "WI-010",
            "WI-013"
          ]
        }
      },
      {
