          "title": "Time in Each State",
          "content": "Identify bottlenecks"
        },
        {
          "id": "metric_002",
          "title": "Validation Failure Rate",
          "content": "Improve AI generation quality"
        },
        {
          "id": "metric_003",
          "title": "Refinement Cycles",
          "content": "Measure until approval"
        },
        {
          "id": "metric_004",
          "title": "Human Intervention Points",
          "content": "Reduce where possible"
        },
        {
          "id": "metric_005",
          "title": "Error Patterns",
          "content": "Common validation failures"
        }
      ]
    }
  },
  {
